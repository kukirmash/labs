@startuml
' Контекстная диаграмма C4 (уровень 1) ИС «Экскурсионное бюро»
!include <C4/C4_Context>
skinparam dpi 160
skinparam shadowing false

title Контекстная диаграмма (C4, уровень 1): ИС «Экскурсионное бюро»

Person(client, "Клиент", "Физическое лицо. Просматривает каталог, оформляет и оплачивает заявки, получает документы")
Person(guide, "Гид", "Сотрудник бюро. Проводит экскурсии, отмечает явку участников, отправляет отчёты")
Person(manager, "Руководитель", "Управляет справочниками, контролирует договоры и платежи, формирует отчёты")

System(bureau, "ИС «Экскурсионное бюро»", "Автоматизирует учёт клиентов, экскурсий и ресурсов, документооборот, финансовый контроль и аналитику")

System_Ext(payment, "Платёжный шлюз", "Банковский эквайринг: приём оплаты и возврат средств")
System_Ext(notify, "Сервис уведомлений", "E-mail и SMS: уведомления клиентам и гидам, рассылка документов")

Rel(client, bureau, "Просматривает каталог, оформляет и оплачивает заявки, получает документы", "HTTPS")
Rel(guide, bureau, "Просматривает назначения, ведёт ход экскурсии, отправляет отчёты", "HTTPS")
Rel(manager, bureau, "Ведёт справочники, контролирует платежи, формирует отчёты", "HTTPS")
Rel(bureau, payment, "Инициирует оплату и возврат средств", "API эквайринга")
Rel(payment, bureau, "Передаёт статусы платежей", "уведомления")
Rel(bureau, notify, "Отправляет уведомления и пакеты документов", "SMTP / API")

LAYOUT_WITH_LEGEND()
@enduml
