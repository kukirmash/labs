@startuml
' Контекстная диаграмма C4 (уровень 1) ИС «Экскурсионное бюро»
!include <C4/C4_Context>
skinparam dpi 160
skinparam shadowing false

title Контекстная диаграмма (C4, уровень 1): ИС «Экскурсионное бюро»

Person(client, "Клиент", "Физическое лицо. Просматривает каталог, оформляет и оплачивает договоры, получает электронные билеты, оставляет отзывы")
Person(guide, "Гид", "Сотрудник бюро. Просматривает расписание, отмечает явку по билетам, меняет статус экскурсии, отправляет отчёты")
Person(manager, "Руководитель (Администратор)", "Управляет справочниками и учётными записями, контролирует договоры и платежи, формирует отчёты")

System(bureau, "ИС «Экскурсионное бюро»", "Каталог маршрутов и экскурсий, договоры и платежи, электронные билеты, отчёты о проведении, уведомления")

System_Ext(acquiring, "Банковский эквайринг", "Платёжный шлюз: приём платежей и возврат средств")
System_Ext(smtp, "Почтовый шлюз (SMTP)", "Отправка уведомлений и копий пакетов документов на e-mail")

Rel(client, bureau, "Просматривает каталог, оформляет и оплачивает договоры, получает билеты, оставляет отзывы", "HTTPS")
Rel(guide, bureau, "Просматривает расписание, отмечает явку, меняет статус экскурсии, отправляет отчёты", "HTTPS")
Rel(manager, bureau, "Управляет справочниками, договорами и платежами, формирует отчёты", "HTTPS")
Rel(bureau, acquiring, "Инициирует платежи и возвраты", "API эквайринга")
Rel(acquiring, bureau, "Передаёт статусы платежей", "уведомления")
Rel(bureau, smtp, "Отправляет уведомления и копии пакетов документов", "SMTP")

LAYOUT_WITH_LEGEND()
@enduml
