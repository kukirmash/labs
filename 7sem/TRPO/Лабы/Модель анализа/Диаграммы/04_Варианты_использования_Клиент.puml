@startuml
' Диаграмма вариантов использования: клиентские сервисы (фрагмент 1)
left to right direction
skinparam dpi 160
skinparam shadowing false
skinparam roundcorner 10
skinparam usecaseFontSize 14
skinparam usecaseFontName "Times New Roman"
skinparam actorFontSize 14
skinparam actorFontName "Times New Roman"
skinparam arrowFontSize 12
skinparam arrowFontName "Times New Roman"
skinparam packageFontSize 14
skinparam packageFontName "Times New Roman"
skinparam nodesep 35
skinparam ranksep 55

title Диаграмма вариантов использования: сервисы клиента (фрагмент 1)

actor "Клиент" as Client
actor "Платёжный шлюз\n(эквайринг)" as PaymentGateway
actor "Сервис уведомлений\n(e-mail, SMS)" as Notifier

rectangle "ИС «Экскурсионное бюро»" {
  package "Клиентские сервисы" {
    usecase "Просмотреть каталог\nэкскурсионных продуктов" as UC1
    usecase "Оформить заявку" as UC2
    usecase "Зарезервировать ресурсы\nэкскурсии" as UC3
    usecase "Оплатить заявку" as UC4
    usecase "Получить пакет\nдокументов" as UC5
    usecase "Отказаться от заявки" as UC6
    usecase "Просмотреть историю\nбронирований" as UC7
    usecase "Добавить продукт\nв избранное" as UC8
  }
}

Client --> UC1
Client --> UC2
Client --> UC4
Client --> UC5
Client --> UC7
PaymentGateway -down-> UC4
Notifier -down-> UC4
Notifier -down-> UC5

UC2 .> UC3 : <<include>>
UC8 .> UC1 : <<extend>>
UC6 .> UC7 : <<extend>>
@enduml
