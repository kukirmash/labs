@startuml
skinparam linetype ortho
' Связи построены ортогонально (под углом 90 градусов)
' Атрибуты классов взяты из логической схемы данных курсовой работы («Экскурсионное бюро»)
skinparam dpi 160
skinparam shadowing false
skinparam roundcorner 10
skinparam nodesep 70
skinparam ranksep 115
skinparam classFontSize 15
skinparam classFontName "Times New Roman"
skinparam classAttributeFontSize 12
skinparam classAttributeFontName "Times New Roman"
skinparam classAttributeIconSize 0
skinparam arrowFontSize 12
skinparam arrowFontName "Times New Roman"
hide methods
hide empty members
hide circle

title Модель предметной области ИС «Экскурсионное бюро»

class "Клиент" as Client {
  фамилия
  имя
  отчество
  дата рождения
  номер телефона
  email
  серия и номер паспорта
}

class "Заявка" as Request {
  номер
  дата оформления
  количество участников
  статус
}

class "Участник" as Participant {
  ФИО
  отметка о явке
}

class "Договор" as Contract {
  номер
  дата составления
  цена
  статус оплаты
}

class "Платёж" as Payment {
  сумма
  вид оплаты
  дата изменения статуса
  статус
}

class "ЭкскурсионныйПродукт" as Product {
  название
  описание
  продолжительность
  дата создания
  базовая стоимость
  тип
  возрастное ограничение
  статус
}

class "Экскурсия" as Excursion {
  дата начала
  дата окончания
  оклад гиду
  мин. число участников
  макс. число участников
  статус
}

class "Группа" as Group {
  размер группы
  дата формирования
}

class "Гид" as Guide {
  фамилия
  имя
  отчество
  дата рождения
  серия паспорта
  номер паспорта
  специализация
  номер лицензии
  номер телефона
  email
}

class "ТранспортноеСредство" as Vehicle {
  вид транспорта
  госномер
  вместимость
  номер телефона водителя
}

class "ОтчётОПроведении" as Report {
  текст отчёта
  дата
  фотографии
}

abstract class "Документ" as Document {
  номер
  дата формирования
}

class "Счёт" as Invoice {
  сумма к оплате
}

class "Билет" as Ticket {
  QR-код
}

class "МаршрутныйЛист" as RouteSheet {
  точки маршрута
  расписание
}

class "ПосадочнаяВедомость" as BoardingList {
  список участников
}

' --- Связи предметной области ---
Client "1" -down- "0..*" Request : оформляет
Product "1" -down- "0..*" Excursion : проводится по
Guide "1" -down- "0..*" Excursion : проводит
Vehicle "1" -down- "0..*" Excursion : обслуживает
Request "1" -down- "1" Contract : предусматривает
Request "1" -down- "1..*" Participant : включает
Request "0..*" -right- "1" Excursion : оформляется на
Excursion "1" -down- "0..1" Group : проводится для
Excursion "1" -down- "0..1" Report : завершается
Group "1" -down- "1..*" Participant : объединяет
Payment "0..*" -up- "1" Contract : оплачивается

' --- Обобщение документов ---
Contract -down-|> Document
Invoice -down-|> Document
Ticket -down-|> Document
RouteSheet -down-|> Document
BoardingList -down-|> Document

' --- Связи документов ---
Invoice "0..*" -up- "1" Contract : выставляется по
Ticket "1..*" -up- "1" Participant : выписывается на
RouteSheet "1" -up- "1" Excursion : сопровождает
BoardingList "1" -up- "1" Group : фиксирует состав

@enduml
