@startuml
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam activityBackgroundColor #EAF1FB
skinparam activityBorderColor #355C8C
skinparam activityDiamondBackgroundColor #FFF4D6
skinparam activityDiamondBorderColor #8C6D1F
skinparam arrowColor #355C8C

start
:Запустить приложение;
if (Первый запуск?) then (да)
  repeat
    :Запросить пароль учителя;
    :Ввести пароль;
  repeat while (Пароль неверный?) is (да) not (нет)
  :Сохранить пароль в настройках;
else (нет)
  :Загрузить сохранённые настройки;
endif
:Открыть главное окно;
stop
@enduml
