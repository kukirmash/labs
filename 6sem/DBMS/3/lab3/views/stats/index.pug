extends ../layout

block content
  br
  a.back-link(href="/") &larr; На главную
  h1= title

  //- 1. БЛОК СТАТИСТИКИ ПРОДАЖ ИЗ REDIS
  h2 Статистика покупок товаров (Redis)
  if redisStats && redisStats.length
    table(style="width: 100%; border-collapse: collapse; text-align: left; margin-bottom: 30px;")
      thead
        tr(style="background: #e0e0e0;")
          th(style="padding: 8px; border: 1px solid #ddd; width: 100px;") ID
          th(style="padding: 8px; border: 1px solid #ddd;") Товар
          th(style="padding: 8px; border: 1px solid #ddd; width: 150px;") Покупок
      tbody
        each row in redisStats
          tr
            td(style="padding: 8px; border: 1px solid #ddd;")= row.id
            td(style="padding: 8px; border: 1px solid #ddd;")= row.label
            td(style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #2ecc71;")= row.purchases
  else
    p(style="color: #999; italic;") Данные о покупках в Redis отсутствуют.

  //- 2. БЛОК ЛОГОВ ИЗМЕНЕНИЯ СТАТУСОВ ИЗ CLICKHOUSE
  h2 Лог статусов заказов (ClickHouse)
  if clickhouseStats && clickhouseStats.length
    table(style="width: 100%; border-collapse: collapse; text-align: left;")
      thead
        tr(style="background: #e0e0e0;")
          th(style="padding: 8px; border: 1px solid #ddd; width: 150px;") Заказ
          th(style="padding: 8px; border: 1px solid #ddd;") Статус
          th(style="padding: 8px; border: 1px solid #ddd; width: 250px;") Время изменения
      tbody
        each row in clickhouseStats
          tr
            td(style="padding: 8px; border: 1px solid #ddd;") Заказ # #{row.order_id}
            td(style="padding: 8px; border: 1px solid #ddd;")
              span(style="background: #f1f2f6; padding: 2px 6px; border-radius: 4px; border: 1px solid #ced6e0;")= row.status_label
            td(style="padding: 8px; border: 1px solid #ddd; color: #57606f;")= row.ts_changed
  else
    p(style="color: #999; italic;") Логи изменений в ClickHouse отсутствуют.
