extends ../layout

block content
  a.back-link(href="/") &larr; На главную
  h1 Товар: #{product.label}

  //- Блок 1: Базовые данные из PostgreSQL
  div.order-details(style="border-left-color: #3498db;")
    h3 Основная информация (PostgreSQL)
    p #[strong Артикул (SKU):] #{product.sku}
    p #[strong Название:] #{product.label}
    p #[strong Базовая цена:] <span style="font-size: 1.2em; color: #2ecc71; font-weight: bold;">#{product.base_price} ₽</span>

  //- Блок 2: Счетчик из Redis
  div.order-details(style="border-left-color: #e67e22;")
    h3 Статистика (Redis)
    p #[strong Количество покупок:] <span style="font-size: 1.2em; color: #e67e22; font-weight: bold;">#{purchases}</span>

  //- Блок 3: Сложные JSON данные из MongoDB
  if details
    div.order-details(style="border-left-color: #1abc9c;")
      h3 Расширенные характеристики (MongoDB)
      if details.brand
        p #[strong Бренд:] #{details.brand}
      if details.category
        p #[strong Категория:] #{details.category}
      if details.color
        p #[strong Цвет:] #{details.color}
      if details.type
        p #[strong Тип:] #{details.type}
  else
    div.order-details(style="border-left-color: #95a5a6;")
      h3 Расширенные характеристики (MongoDB)
      p(style="color: #7f8c8d; font-style: italic;") Расширенная информация для данного товара не найдена в MongoDB.