doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/stylesheets/style.css')

    script(src='/javascripts/jquery.min.js')
    script(src='/javascripts/layout.js')
  body
    if user
      div
        span= user.fio
    block content

    div#login_popup.q-window
      div.q-window-block
        a#login_popup_close(href="#") &times;
        div.q-window-header Вход
        div.q-window-body.q-form
          div.q-form-data
            label(for="inpLogin") Логин
            input#inpLogin(type="text")
          div.q-form-data
            label(for="inpPassword") Пароль
            input#inpPassword(type="password")
          div.q-buttons
            a#submit_login Войти
